# Copy desired settings into environment variables before deployment.
PORT=3000
NODE_ENV=development
# Demo payment is intentionally OFF in production.
ENABLE_DEMO_PAYMENT=true
# Change BOTH passwords before deploying or sharing access.
ADMIN_PASSWORD=use-a-long-unique-password
STAFF_PASSWORD=use-another-long-unique-password
# Database path defaults to ./data/doitung.sqlite
# DB_PATH=./data/doitung.sqlite
